# ============================================================
# Myntra Wishlist-to-Purchase Discovery Engine
# Copy this file to .env and fill in values. Never commit .env.
# ============================================================

# --- AI (OpenRouter) ---
# Local: set these in .env
# Streamlit Cloud: set the same names in App settings → Secrets
# Never commit a real key. Never put a real key in this file.
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_MAX_TOKENS=2000
AI_BATCH_SIZE=10
ANALYSIS_BATCH_SIZE=10
MAX_OUTPUT_TOKENS=2000

# Storage: combined Google Play + Apple, never above 500
MAX_TOTAL_REVIEWS=500
MAX_DATASET_REVIEWS=500
# AI sample: not the full stored set
MAX_ANALYSIS_REVIEWS=150
MAX_DISCOVERY_REVIEWS=150
PRUNE_EXCESS_REVIEWS=true

# --- Google Play (official Myntra) ---
GOOGLE_PLAY_APP_ID=com.myntra.android
GOOGLE_PLAY_MAX_REVIEWS=250
GOOGLE_PLAY_BATCH_SIZE=100
GOOGLE_PLAY_LANGUAGE=en
GOOGLE_PLAY_COUNTRY=in

# --- Apple App Store (official Myntra) ---
APPLE_APP_ID=907394059
APPLE_PRIMARY_REGION=in
APPLE_FALLBACK_REGION=us
APPLE_MAX_REVIEWS=250

# --- Database ---
DATABASE_URL=sqlite:///./myntra_discovery.db

# --- Collection ---
COLLECTION_RATE_LIMIT_SECONDS=1.0
COLLECTION_RETRY_ATTEMPTS=3
COLLECTION_WINDOW_DAYS=30
GOOGLE_PLAY_WINDOW_SAFETY_LIMIT=250
APPLE_WINDOW_SAFETY_LIMIT=250
REFRESH_SAFETY_LIMIT=150
EXPECTED_APP_NAME=Myntra
EXPECTED_APPLE_APP_NAME=Myntra Fashion Shopping App
AI_ANALYSIS_BATCH_SIZE=150
AI_REQUEST_BATCH_SIZE=10
AI_RETRY_ATTEMPTS=5

HOST=127.0.0.1
PORT=8000
