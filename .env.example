# ============================================================
# Myntra Wishlist-to-Purchase Discovery Engine
# Copy this file to .env and fill in values. Never commit .env.
# ============================================================

# --- AI ---
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct Gemini (used only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Play (official Myntra) ---
GOOGLE_PLAY_APP_ID=com.myntra.android
GOOGLE_PLAY_MAX_REVIEWS=5000
GOOGLE_PLAY_BATCH_SIZE=100
GOOGLE_PLAY_LANGUAGE=en
GOOGLE_PLAY_COUNTRY=in

# --- Apple App Store (official Myntra) ---
APPLE_APP_ID=907394059
APPLE_PRIMARY_REGION=in
APPLE_FALLBACK_REGION=us
APPLE_MAX_REVIEWS=5000

# --- Database ---
DATABASE_URL=sqlite:///./myntra_discovery.db

# --- Collection ---
COLLECTION_RATE_LIMIT_SECONDS=1.0
COLLECTION_RETRY_ATTEMPTS=3
COLLECTION_WINDOW_DAYS=30
GOOGLE_PLAY_WINDOW_SAFETY_LIMIT=800
APPLE_WINDOW_SAFETY_LIMIT=500
REFRESH_SAFETY_LIMIT=150
EXPECTED_APP_NAME=Myntra
AI_ANALYSIS_BATCH_SIZE=60

HOST=127.0.0.1
PORT=8000
